{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "**/*.astro",
    "src/content/**",
    "presentations/**",
    "dist/**",
    ".astro/**",
    ".wrangler/**",
    "pnpm-lock.yaml"
  ]
}
