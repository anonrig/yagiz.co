---
interface Props {
  href: string
  class?: string
}

const { href, class: className } = Astro.props
---

<a
  href={href}
  class:list={[
    'text-xs font-bold text-neutral-500 hover:text-neutral-400 dark:text-neutral-500 dark:hover:text-neutral-400',
    className,
  ]}
>
  View as Markdown
</a>
