<script>
  const copiedTimeouts = new WeakMap<HTMLButtonElement, number>()

  function fenceText(pre: Element): string {
    const lines = pre.querySelectorAll('.line')
    if (lines.length === 0) {
      return pre.textContent ?? ''
    }

    return Array.from(lines, (line) => {
      const text = line.textContent ?? ''
      return text === ' ' ? '' : text
    }).join('\n')
  }

  async function copyFence(button: HTMLButtonElement, pre: Element): Promise<void> {
    const ok = await writeClipboard(fenceText(pre))
    if (ok) {
      markCopied(button)
    }
  }

  async function writeClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text)
      return true
    } catch {
      return false
    }
  }

  function markCopied(button: HTMLButtonElement): void {
    const previous = copiedTimeouts.get(button)
    if (previous !== undefined) {
      globalThis.clearTimeout(previous)
    }

    button.classList.add('is-copied')
    button.setAttribute('aria-label', 'Copied')
    button.title = 'Copied'

    const timeout = globalThis.setTimeout(() => {
      button.classList.remove('is-copied')
      button.setAttribute('aria-label', 'Copy code')
      button.title = 'Copy code'
      copiedTimeouts.delete(button)
    }, 2000)
    copiedTimeouts.set(button, timeout)
  }

  document.addEventListener('click', (event) => {
    const {target} = event
    if (!(target instanceof Element)) {
      return
    }

    const button = target.closest('.astro-code-copy')
    if (!(button instanceof HTMLButtonElement)) {
      return
    }

    const figure = button.closest('.astro-code-figure')
    const pre = figure?.querySelector('pre')
    if (!pre) {
      return
    }

    void copyFence(button, pre)
  })
</script>
