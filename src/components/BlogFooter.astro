---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { ArrowLeft, ArrowRight } from '@lucide/astro'
import authorImg from '@/assets/author-image.png'
import Container from '@/components/ui/Container.astro'
import { authorFullName, authorJobTitle } from '@/lib/content'
import { absoluteUrl, schemaIds } from '@/lib/schema'

interface Props {
  index: number
  posts: CollectionEntry<'blog'>[]
}

const { index, posts }: Props = Astro.props
const next = index === 0 ? undefined : posts.at(index - 1)
const previous = index === posts.length - 1 ? undefined : posts.at(index + 1)
---

<Container size="tight" class="mt-16 flex items-center mx-auto px-[4vw]" as="footer">
  <div class="flex min-w-0 flex-2 text-black dark:text-neutral-400">
    {
      previous !== undefined && (
        <a
          href={`/${previous.id}`}
          class="flex min-w-0 items-center gap-2 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2"
        >
          <ArrowLeft size={20} aria-hidden="true" class="shrink-0" />
          <span class="truncate text-sm font-medium">{previous.data.title}</span>
        </a>
      )
    }
  </div>

  <div
    class="flex shrink-0 flex-col items-center px-3"
    itemprop="author"
    itemscope
    itemtype="https://schema.org/Person"
    itemid={schemaIds.person}
  >
    <p class="mb-3 text-center text-xs font-extrabold tracking-wide text-slate-800 dark:text-white">
      Published by
    </p>
    <a
      href="/about"
      rel="author"
      class="flex flex-col items-center gap-y-2 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2"
    >
      <Image
        src={authorImg}
        alt=""
        width={50}
        height={50}
        layout="fixed"
        class="rounded-full"
        itemprop="image"
      />
      <span itemprop="name" class="text-center text-sm font-extrabold text-slate-800 dark:text-white">
        {authorFullName}
      </span>
    </a>
    <link itemprop="url" href={absoluteUrl('/about')} />
    <p class="mt-1 text-center text-xs text-neutral-500 dark:text-neutral-400" itemprop="jobTitle">
      {authorJobTitle}
    </p>
  </div>

  <div class="flex min-w-0 flex-2 justify-end text-black dark:text-neutral-400">
    {
      next !== undefined && (
        <a
          href={`/${next.id}`}
          class="flex min-w-0 items-center justify-end gap-2 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2"
        >
          <span class="truncate text-sm font-medium">{next.data.title}</span>
          <ArrowRight size={20} aria-hidden="true" class="shrink-0" />
        </a>
      )
    }
  </div>
</Container>
