---
import { absoluteUrl } from '@/lib/schema'
import type { BreadcrumbItem } from '@/lib/schema'

interface Props {
  items: BreadcrumbItem[]
  itemprop?: string
}

const { items, itemprop } = Astro.props
const current = items.at(-1)
const itemId = `${absoluteUrl(current?.path ?? '/')}#breadcrumb`
---

<nav aria-label="Breadcrumb" class="text-xs font-bold">
  <ol
    class="flex flex-wrap items-center justify-center gap-y-1 text-neutral-500 dark:text-neutral-400"
    itemscope
    itemtype="https://schema.org/BreadcrumbList"
    itemid={itemId}
    itemprop={itemprop}
  >
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1
        const itemUrl = absoluteUrl(item.path)
        return (
          <li
            class="flex max-w-full items-center"
            itemscope
            itemprop="itemListElement"
            itemtype="https://schema.org/ListItem"
          >
            {index > 0 && (
              <span aria-hidden="true" class="px-2 font-serif leading-[1] text-neutral-400">
                /
              </span>
            )}
            {isLast ? (
              <span class="truncate" itemprop="name" aria-current="page">
                {item.name}
              </span>
            ) : (
              <a class="text-orange-400 hover:text-orange-300" href={item.path}>
                <span itemprop="name">{item.name}</span>
              </a>
            )}
            <link itemprop="item" href={itemUrl} />
            <meta itemprop="position" content={String(index + 1)} />
          </li>
        )
      })
    }
  </ol>
</nav>
