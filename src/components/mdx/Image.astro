---
import { Image as AstroImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: string
  alt: string
  class?: string
}

const { src, class: className, alt }: Props = Astro.props

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*')

const isAsset = src.startsWith('/')
const key = `/src/assets${src}`
const loadImage = images[key]
if (isAsset && loadImage === undefined) {
  throw new Error('src should not be empty')
}

const loaded = isAsset && loadImage ? await loadImage() : undefined
const asset = loaded?.default
const imageClass = [
  'rounded-lg object-contain w-full !h-[unset] !relative bg-white dark:bg-white-reversed col-wide',
  className,
]
---

{
  asset ? (
    <AstroImage
      src={asset}
      {alt}
      width={asset.width}
      height={asset.height}
      layout="constrained"
      class:list={imageClass}
    />
  ) : (
    <img {src} {alt} loading="lazy" decoding="async" class:list={imageClass} />
  )
}
