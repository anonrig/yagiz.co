---
import { getEntry } from 'astro:content'
import Page from '@/components/Page.astro'
import Layout from '@/layouts/Layout.astro'
import { authorDescription, authorFullName, profileUrls, websiteUrl } from '@/lib/content'
import { aboutPageJsonLd, absoluteUrl, pageBreadcrumbs, schemaIds } from '@/lib/schema'

const page = await getEntry('pages', 'about')
if (!page) {
  throw new Error('Page not found')
}

const markdownUrl = `${websiteUrl}/about.md`
const breadcrumbs = pageBreadcrumbs(page.data.title, '/about')
---
<Layout
  title={page.data.title}
  description={page.data.description}
  markdownUrl={markdownUrl}
  jsonLd={aboutPageJsonLd(page.data.title, page.data.description)}
  schemaType="https://schema.org/ProfilePage"
  microdataName={false}
>
  <Page
    {page}
    itemtype="https://schema.org/ProfilePage"
    breadcrumbs={breadcrumbs}
  >
    <div
      itemprop="mainEntity"
      itemscope
      itemtype="https://schema.org/Person"
      itemid={schemaIds.person}
    >
      <meta itemprop="name" content={authorFullName} />
      <meta itemprop="description" content={authorDescription} />
      <link itemprop="url" href={absoluteUrl('/about')} />
      {profileUrls.map((href) => <link itemprop="sameAs" href={href} />)}
    </div>
  </Page>
</Layout>
