{
  "name": "yagiz-co",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev --port 3000",
    "build": "wrangler types && astro check && astro build",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "wrangler dev",
    "astro": "astro",
    "lint": "wrangler types && astro sync && oxlint . && oxfmt --check",
    "lint-fix": "wrangler types && astro sync && oxlint --fix . && oxfmt",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "cli": "node --no-warnings ./cli.mjs",
    "presentation": "marp --allow-local-files -s ./presentations"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@clack/prompts": "^1.8.1",
    "@lucide/astro": "^1.59.0",
    "@shikijs/transformers": "^4.5.0",
    "@shikijs/types": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "handlebars": "^4.7.10",
    "mjml": "^5.4.1",
    "node-mailjet": "^6.0.11",
    "satori": "^0.62.0",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@marp-team/marp-cli": "^4.5.1",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "to-vfile": "^8.0.0",
    "typescript": "^6.0.3",
    "vfile-matter": "^5.0.1"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "puppeteer",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "@cloudflare/vite-plugin": "^1.63.1"
    }
  }
}
