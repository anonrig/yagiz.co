{
  "name": "yagiz-co",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev --port 3000",
    "build": "wrangler types && node ./scripts/astro-check.mjs && astro build",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "wrangler dev",
    "astro": "astro",
    "lint": "biome check .",
    "lint-fix": "biome check . --write",
    "cli": "node --no-warnings ./cli.mjs",
    "presentation": "marp --allow-local-files -s ./presentations"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/compiler-rs": "^0.4.0",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/markdown-satteri": "^0.3.7",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@clack/prompts": "^1.7.0",
    "@lucide/astro": "^1.33.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@yagiz/astro-check": "file:tools/astro-check",
    "astro": "^7.2.4",
    "handlebars": "^4.7.9",
    "mjml": "^5.4.0",
    "node-mailjet": "^6.0.11",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.33.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.125.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@biomejs/biome": "^2.5.10",
    "@marp-team/marp-cli": "^4.5.0",
    "@types/node": "^26.2.0",
    "to-vfile": "^8.0.0",
    "typescript": "^7.0.2",
    "vfile-matter": "^5.0.1"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "esbuild",
      "puppeteer",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "@astrojs/compiler-rs": "^0.4.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "7"
      }
    }
  }
}
